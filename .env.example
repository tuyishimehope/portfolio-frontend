# PostHog project API key (starts with phc_). Safe to expose to the browser.
POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=$POSTHOG_TOKEN
# US cloud. For the EU cloud use https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Explicit opt-in for local testing and SDK diagnostics. Leave false normally.
NEXT_PUBLIC_POSTHOG_DEBUG=false
